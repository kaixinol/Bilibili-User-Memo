    "@types/alpinejs__persist": "^3.13.4",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "browserslist": "^4.28.9",
    "eslint": "^10.10.0",
    "lightningcss": "^1.33.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
